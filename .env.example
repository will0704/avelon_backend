# =====================================================
# AVELON BACKEND - ENVIRONMENT VARIABLES
# =====================================================
# Copy this file to .env and fill in your values

# Opt-in only. Keeping this false prevents local/dev instances from polling
# infrastructure or generating background traffic.
ENABLE_BACKGROUND_JOBS="false"
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:19006,https://avelon-web.vercel.app"

# =====================================================
# DATABASE
# =====================================================
DATABASE_URL="postgresql://avelon:avelon_password@localhost:5432/avelon_db"

# =====================================================
# REDIS
# =====================================================
REDIS_URL="redis://localhost:6379"

# =====================================================
# JWT AUTHENTICATION
# =====================================================
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# =====================================================
# EMAIL (Gmail API OAuth2)
# =====================================================
# Setup: https://console.cloud.google.com → Enable Gmail API → Create OAuth2 credentials
# Get refresh token: https://developers.google.com/oauthplayground
GMAIL_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GMAIL_CLIENT_SECRET="your-client-secret"
GMAIL_REFRESH_TOKEN="your-refresh-token"
GMAIL_USER="your-email@gmail.com"

# =====================================================
# BLOCKCHAIN (Base Sepolia Testnet)
# =====================================================
# Get RPC URL from Alchemy: https://dashboard.alchemy.com
# Get Base Sepolia ETH from: https://portal.cdp.coinbase.com/products/faucet
CHAIN_ID="84532"
CHAIN_RPC_URL="https://base-sepolia.g.alchemy.com/v2/YOUR_KEY"
CHAIN_PRIVATE_KEY="0x..."
CHAIN_MIN_CONFIRMATIONS="1"
TREASURY_ADDRESS="0x..."

# Deploying to Base Sepolia also reads these (contracts/scripts/deploy.ts)
BASE_SEPOLIA_RPC_URL="https://base-sepolia.g.alchemy.com/v2/YOUR_KEY"
BASE_SEPOLIA_PRIVATE_KEY="0x..."

# Old Ethereum Sepolia names — still honoured as a fallback if CHAIN_* are unset
# SEPOLIA_RPC_URL="https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY"
# SEPOLIA_PRIVATE_KEY="0x..."

# Deployed Contract Addresses (run deploy script to get these)
AVELON_LENDING_ADDRESS="0x..."
COLLATERAL_MANAGER_ADDRESS="0x..."
REPAYMENT_SCHEDULE_ADDRESS="0x..."

# =====================================================
# AI SERVICE
# =====================================================
AI_SERVICE_URL="http://localhost:8000"
AI_API_KEY="dev-api-key-change-in-production"

# =====================================================
# FIREBASE (Push Notifications)
# =====================================================
FIREBASE_PROJECT_ID="avelon-xxxxx"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----..."
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@..."

# =====================================================
# FILE STORAGE
# =====================================================
STORAGE_PATH="./uploads"
ENCRYPTION_KEY="your-32-byte-encryption-key-here"
# Local mode is for synthetic documents during local defense demos only.
# Production KYC routes refuse local ephemeral storage.
KYC_STORAGE_MODE="local"

# =====================================================
# DATABASE ENCRYPTION
# =====================================================
PRISMA_FIELD_ENCRYPTION_KEY="k1.aesgcm256.random-32-byte-key-here="

# =====================================================
# LOCAL DEMO SEEDING (NEVER ENABLE IN PRODUCTION)
# =====================================================
# The seed script refuses to run unless explicitly enabled and passwords are
# provided here. Use unique values and do not commit your real .env file.
DEMO_SEED_ENABLED="false"
DEMO_ADMIN_PASSWORD="replace-with-a-unique-local-password"
DEMO_BORROWER_PASSWORD="replace-with-a-unique-local-password"
DEMO_BORROWER_2_PASSWORD="replace-with-a-unique-local-password"
DEMO_INVESTOR_PASSWORD="replace-with-a-unique-local-password"

# =====================================================
# APP CONFIGURATION
# =====================================================
NODE_ENV="development"
PORT=3001

# Proxies in front of this server. Rate limiting reads that many trailing
# X-Forwarded-For entries; 0 ignores the header and uses the socket address.
# Leave at 0 locally. Set to 1 on Render (one load balancer in front).
TRUSTED_PROXY_COUNT=0

ETH_PHP_RATE="150000"
# Borrower's own stake as a % of principal, not full security for the debt
MIN_COLLATERAL_RATIO="35"
WARNING_COLLATERAL_RATIO="40"
GRACE_PERIOD_HOURS="24"
LIQUIDATION_PENALTY_PERCENT="5"

# Development only: return verification codes in API responses (no mailbox needed).
DEMO_EXPOSE_OTP="false"

# ── Local Hardhat chain (capstone demo) ──────────────────────────────────────
# Start it with: npm run chain:local
# Deploy and sync addresses with: npm run demo:reset
# CHAIN_ID="31337"
# CHAIN_RPC_URL="http://127.0.0.1:8545"
# CHAIN_PRIVATE_KEY is Hardhat's published account #0 on this chain — local only.

# Investor liquidity pool. Written by the deploy script; without it the investor
# portal reports itself unconfigured rather than guessing an address.
LIQUIDITY_POOL_ADDRESS=
